{
  "manifest_version": 3,
  "name": "NoStim",
  "version": "1.1.2",
  "description": "Stay focused by blocking distracting sites. No stim lock in.",
  "homepage_url": "https://github.com/Agamenticus/NoStim",
  "author": "Evan Rankin",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content-scripts/linkedin-shield-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content-scripts/linkedin-shield.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
